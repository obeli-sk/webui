%YAML 1.2
---
# Minimal stateless rules; multi-line strings only highlight their delimiters.
name: TOML
file_extensions: [toml]
scope: source.toml
contexts:
  main:
    - match: '#.*$'
      scope: comment.line.number-sign.toml
    - match: '^\s*(\[\[?)([^\]]*)(\]\]?)'
      captures:
        1: punctuation.definition.table.toml
        2: entity.name.tag.table.toml
        3: punctuation.definition.table.toml
    - match: '(?:[A-Za-z0-9_-]+|"[^"]*"|''[^'']*'')(?=\s*[.=])'
      scope: entity.other.attribute-name.key.toml
    - match: '"""|'''''''
      scope: string.quoted.triple.toml
    - match: '"(?:\\.|[^"\\])*"'
      scope: string.quoted.double.toml
    - match: '''[^'']*'''
      scope: string.quoted.single.toml
    - match: '\b(?:true|false)\b|[+-]?\b(?:inf|nan)\b'
      scope: constant.language.toml
    - match: '\b\d{4}-\d{2}-\d{2}(?:[Tt ]\d{2}:\d{2}:\d{2}(?:\.\d+)?(?:[Zz]|[+-]\d{2}:\d{2})?)?\b|\b\d{2}:\d{2}:\d{2}(?:\.\d+)?\b'
      scope: constant.other.datetime.toml
    - match: '[+-]?\b(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|\d[\d_]*(?:\.\d[\d_]*)?(?:[eE][+-]?\d+)?)\b'
      scope: constant.numeric.toml
    - match: '='
      scope: keyword.operator.assignment.toml
